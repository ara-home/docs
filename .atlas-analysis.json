{
  "projectType": "cli-tool",
  "projectName": "SCAL-P",
  "projectDescription": "A Go CLI tool that wraps npm and pnpm to enforce dependency policies, verify integrity via SHA-512 hashing, and log every install as a security checkpoint between your project and the npm ecosystem.",
  "theme": "aspen",
  "primaryColor": "#1A7A6E",
  "lightColor": "#E8F5F3",
  "darkColor": "#0D4A44",
